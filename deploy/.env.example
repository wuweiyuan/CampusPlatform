# Nginx 对外端口
  HTTP_PORT=80

  # MySQL 数据库名称和业务用户
  MYSQL_DATABASE=campus_trade
  MYSQL_USER=campus_app

  # MySQL 密码占位值
  MYSQL_PASSWORD=replace_with_database_password
  MYSQL_ROOT_PASSWORD=replace_with_root_password

  # Redis 密码占位值
  REDIS_PASSWORD=replace_with_redis_password

  # JWT 签名密钥占位值
  APP_JWT_SECRET=replace_with_base64_encoded_random_secret

  # 登录 Token 有效期，单位为秒
  JWT_EXPIRE_SECONDS=7200