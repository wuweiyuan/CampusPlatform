# Nginx 对外端口
  HTTP_PORT=80

  # MySQL 数据库名称和业务用户
  MYSQL_DATABASE=campus_trade
  MYSQL_USER=campus_app

  # MySQL 密码占位值
  MYSQL_PASSWORD=replace_with_database_password
  MYSQL_ROOT_PASSWORD=replace_with_root_password
  # MySQL 映射到本机的端口
  MYSQL_PORT=3306

  # Redis 密码占位值
  REDIS_PASSWORD=replace_with_redis_password

  # JWT 签名密钥占位值
  APP_JWT_SECRET=replace_with_base64_encoded_random_secret

  # 登录 Token 有效期，单位为秒
  JWT_EXPIRE_SECONDS=7200

  # RabbitMQ 登录用户名
  RABBITMQ_USERNAME=campus_trade

  # RabbitMQ 登录密码；这里只放示例值，不要填写生产环境真实密码
  RABBITMQ_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

  # RabbitMQ 提供给 Spring Boot 使用的 AMQP 端口
  RABBITMQ_AMQP_PORT=5672

  # RabbitMQ 网页管理后台端口
  RABBITMQ_MANAGEMENT_PORT=15672
