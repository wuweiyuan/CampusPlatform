# Copy to .env and replace placeholders locally. Never commit the filled .env.
# Spring Boot does not load this file automatically; see README.md.
SPRING_DATASOURCE_URL='jdbc:mysql://localhost:3306/campus_trade?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai'
SPRING_DATASOURCE_USERNAME='REPLACE_WITH_LOCAL_DB_USER'
SPRING_DATASOURCE_PASSWORD='REPLACE_WITH_LOCAL_DB_PASSWORD'
APP_JWT_SECRET='REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES'
JWT_EXPIRE_SECONDS=7200
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=0
# Optional: set locally if your Redis requires authentication.
# SPRING_DATA_REDIS_USERNAME='REPLACE_WITH_LOCAL_REDIS_USER'
# SPRING_DATA_REDIS_PASSWORD='REPLACE_WITH_LOCAL_REDIS_PASSWORD'
SPRING_DATA_REDIS_CONNECT_TIMEOUT=1s
SPRING_DATA_REDIS_TIMEOUT=1s
SERVER_PORT=8080
